# ---- Dashboard ----
APP_PORT=8005
JWT_HOURS=8
COOKIE_SECURE=false              # true cuando esté detrás de HTTPS
OTP_TTL_MIN=10

# Primer admin (se siembra al arrancar si no hay usuarios)
ADMIN_EMAIL=rodrigo@vectus.la

# ---- Ruta a la base del MOTOR (se monta read-only) ----
# Carpeta del host donde el motor guarda vectus.db
ENGINE_DATA_DIR=/home/asi-vectus/vectus-soc/data

# ---- SMTP para enviar el código OTP (si se omite, el código se loguea) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# JWT_SECRET se autogenera si no se define (recomendado fijarlo en prod)
# JWT_SECRET=
