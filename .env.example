# Vectus SOC Engine — configuración (copiar a .env)
# IMPORTANTE: no usar comentarios en la misma línea que un valor —
# algunas versiones de Docker Compose los toman como parte del valor.
# En Fase 1 solo se usan API_KEY e INGEST_MAX_WAIT; el resto queda
# declarado para que el .env no cambie en Fase 2/3.

# --- Fase 1 ---
# key para header X-API-Key (vacío = abierto, red interna)
API_KEY=
# segundos que el POST espera antes de devolver 202 processing
INGEST_MAX_WAIT=25
# nivel Wazuh desde el cual una alerta sin regla curada queda en needs_review
REVIEW_MIN_LEVEL=7

# --- Fase 2 (IA + enriquecimiento + RAG) ---
OPENAI_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
# Shodan no se usa (tier free sin créditos API)
SHODAN_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANALYST_TEMP=0.1
EMBEDDING_MODEL=text-embedding-3-small
# degradar si una API externa falla (false = seguir con lo que hay)
ENRICH_FAIL_HARD=false
VT_MIN_INTERVAL=15
RAG_SIM_THRESHOLD=0.20
RAG_WINDOW_DAYS=90
COLDSTART_MIN_BASELINE=50

# --- Fase 3 (anti-ruido supervisado) ---
NOISE_THRESHOLD=100
NOISE_WINDOW_DAYS=7
# TTL del caché de reputación en horas
ENRICH_CACHE_TTL_HOURS=24
# ventana de correlación temporal en horas y tope de relacionadas
CORRELATION_WINDOW_HOURS=24
CORRELATION_MAX_RELATED=10
# anti-ruido supervisado: candidatas con >= N eventos en la ventana (tasa)
NOISE_MIN_COUNT=20
NOISE_WINDOW_HOURS=168
# minutos antes de declarar colgado un analisis en processing
PROCESSING_TIMEOUT_MINUTES=10
# tamano maximo de payload en KB
MAX_PAYLOAD_KB=512
# reintentos por fuente de reputacion caida
ENRICH_RETRIES=2
